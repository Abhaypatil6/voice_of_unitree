# Required
GROQ_API_KEY=gsk_your_key_here

# Groq model (free tier)
GROQ_MODEL=llama-3.1-8b-instant

# Assistant persona
SYSTEM_PROMPT=You are G1, a helpful voice assistant built into a Unitree G1 humanoid robot. Keep answers concise and conversational. No markdown, no bullet points, plain spoken sentences only.

# TTS: unitree | piper | espeak | none
TTS_BACKEND=unitree
UNITREE_SDK_PATH=/home/unitree/Projects/unitree_sdk2_python
UNITREE_TTS_SPEAKER_ID=0
UNITREE_FALLBACK=

# Piper voice model name (stem of .onnx file)
PIPER_MODEL=en_US-ryan-high
PIPER_MODELS_DIR=tts/models
PIPER_BINARY=piper

# Speaker: unitree (preferred native) | alsa | local (dev laptop)
SPEAKER_BACKEND=unitree
ALSA_OUTPUT_DEVICE=

# ROS topic
ROS_AUDIO_TOPIC=/audio_msg

# Unitree DDS network interface for native TTS
UNITREE_NETWORK_INTERFACE=eth0

# Conversation history
MAX_HISTORY_MESSAGES=10
