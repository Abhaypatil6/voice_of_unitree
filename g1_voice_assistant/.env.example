# ─────────────────────────────────────────────────────────────────────────────
# G1 Voice Assistant – Environment Configuration
# Copy this file to .env and fill in the values:
#     cp .env.example .env
# The .env file is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq API Key (REQUIRED) ───────────────────────────────────────────────────
# Get a free API key at: https://console.groq.com
# NEVER share or commit this key.
GROQ_API_KEY=

# ── Groq LLM Model ────────────────────────────────────────────────────────────
# This is a CHAT/LLM model – NOT a Whisper model.
# Options (fast + free tier): llama-3.1-8b-instant, llama-3.3-70b-versatile
# Default: llama-3.1-8b-instant (lowest latency)
GROQ_MODEL=llama-3.1-8b-instant

# ── Groq Whisper STT Model (standalone mode only) ─────────────────────────────
# Used only in main_standalone.py (local microphone mode).
# NOT used in ROS/G1 mode (Unitree's built-in STT handles transcription).
# Options: whisper-large-v3-turbo (fast), whisper-large-v3 (accurate)
STT_MODEL=whisper-large-v3-turbo

# ── LLM Response Settings ─────────────────────────────────────────────────────
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.7

# ── System Prompt (English-only enforcement) ──────────────────────────────────
# Leave blank to use the default English-only system prompt.
# The default enforces English-only responses and natural spoken style.
# Only override if you have a specific reason.
SYSTEM_PROMPT=

# ── TTS Settings ──────────────────────────────────────────────────────────────
# Backend: piper (high quality, offline) | espeak (robotic, always available)
# Use piper on the G1 (ARM64 binary available).
# Use espeak for quick testing if piper is not set up.
TTS_BACKEND=piper
PIPER_MODEL=en_US-ryan-high
PIPER_MODELS_DIR=tts/models
PIPER_BINARY=piper
# Speech rate: <1.0 = faster, >1.0 = slower, 1.0 = normal
PIPER_LENGTH_SCALE=1.0

# ── Speaker / Audio Output ────────────────────────────────────────────────────
# Backend: alsa (for G1, uses aplay) | local (dev laptop, uses sounddevice)
# Use alsa on the G1. Set ALSA_OUTPUT_DEVICE to the correct hw:X,Y device.
# Find devices with: aplay -l
SPEAKER_BACKEND=alsa
ALSA_OUTPUT_DEVICE=
# Set to true to allow barge-in (interrupt robot speech when user speaks).
SPEAKER_INTERRUPTIBLE=true

# ── ROS 2 Settings (ROS/G1 mode only) ────────────────────────────────────────
# Topic published by the Unitree G1 built-in STT system.
ROS_AUDIO_TOPIC=/audio_msg
# Minimum transcript length in characters (filters very short noise bursts).
MIN_TRANSCRIPT_LENGTH=2
# Minimum transcript confidence (0.0 = accept all, 0.5 = accept above 50%).
MIN_TRANSCRIPT_CONFIDENCE=0.0

# ── Standalone Microphone / VAD Settings (standalone mode only) ───────────────
# These settings apply to main_standalone.py only.
# In ROS mode, VAD is handled by the Unitree G1 hardware.
#
# MIC_DEVICE_INDEX: PyAudio device index. Leave blank to use system default.
#   List available devices:  python3 -c "import pyaudio; pa=pyaudio.PyAudio(); [print(i, pa.get_device_info_by_index(i)['name']) for i in range(pa.get_device_count()) if pa.get_device_info_by_index(i)['maxInputChannels']>0]"
MIC_DEVICE_INDEX=
MIC_SAMPLE_RATE=16000
MIC_CHANNELS=1
MIC_CHUNK_SIZE=1024
# Silence timeout: stop recording after this many seconds of silence.
SILENCE_TIMEOUT=1.5
# VAD threshold: RMS amplitude above which speech is detected (0.0–1.0).
# Lower = more sensitive (picks up whispers). Higher = requires louder speech.
VAD_THRESHOLD=0.01
# Minimum speech duration in seconds. Shorter segments are discarded as noise.
MIN_SPEECH_DURATION=0.3

# ── Conversation History ──────────────────────────────────────────────────────
# Number of user/assistant PAIRS to keep in LLM context.
# Each pair = ~100–200 tokens. 10 pairs = ~1000–2000 tokens of history.
MAX_HISTORY_MESSAGES=10

# ── Paths ─────────────────────────────────────────────────────────────────────
CONVERSATION_DIR=./conversations
LOG_DIR=./logs

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Print per-turn timing summary (STT / LLM / TTS / Total latency).
SHOW_TIMING=true
